<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="egovframework.com.cop.bbs.mapper.BoardWriteAuthMapper">

	<!-- BBS_ID 는 CHAR(30) 이고 bbsId 도 정확히 30자라 패딩 문제가 없다. -->
	<select id="selectWriteAuthorCodes" parameterType="string" resultType="string">
		SELECT AUTHOR_CODE FROM COMTNBBSWRITEAUTHOR WHERE BBS_ID = #{bbsId} ORDER BY AUTHOR_CODE
	</select>

	<delete id="deleteWriteAuthors" parameterType="string">
		DELETE FROM COMTNBBSWRITEAUTHOR WHERE BBS_ID = #{bbsId}
	</delete>

	<insert id="insertWriteAuthor">
		INSERT INTO COMTNBBSWRITEAUTHOR (BBS_ID, AUTHOR_CODE) VALUES (#{bbsId}, #{authorCode})
	</insert>

</mapper>
