            <!-- ────────────────────────────────────────────────────────────────
                 자체 개발 자바 산출물만 JAR 로 묶어 WEB-INF/lib 에 넣는다 (2026-07-31).
                 · 대상 = src/main/java 컴파일 결과(**/*.class) 뿐.
                 · 리소스(globals.properties·매퍼 XML·스프링 XML)는 WEB-INF/classes 에 그대로 둔다
                   — JAR 안으로 들어가면 `classpath:` + 와일드카드 매퍼 로딩이 깨질 수 있어서다
                   (context-mapper.xml 의 classpath:/egovframework/mapper/**/*_${Globals.DbType}.xml).
                 ⚠ 이 설정은 `mvn package`(WAR 빌드) 에만 적용된다. 이클립스 WTP 퍼블리시는
                   배포 어셈블리(org.eclipse.wst.common.component)를 따르므로 여전히
                   WEB-INF/classes 로 나간다 — 개발 중 핫 리로드는 그대로 유지된다.
                 ──────────────────────────────────────────────────────────────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <!-- 버전은 로컬 m2 보유분에 맞춘 값. 온라인 빌드 환경으로 옮기면 최신으로 올릴 것. -->
                <artifactId>maven-jar-plugin</artifactId>
                <version>2.4</version>
                <executions>
                    <execution>
                        <id>pack-app-classes</id>
                        <phase>prepare-package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                            <includes>
                                <include>**/*.class</include>
                            </includes>
                            <!-- WAR(finalName)과 겹치지 않게 별도 스테이징 폴더에 만든다 -->
                            <outputDirectory>${project.build.directory}/app-jar</outputDirectory>
                            <finalName>RLMS_${project.version}</finalName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <!-- 느슨한 .class 는 WAR 에서 제외(리소스는 남는다) -->
                    <packagingExcludes>WEB-INF/classes/**/*.class</packagingExcludes>
                    <webResources>
                        <resource>
                            <directory>${project.build.directory}/app-jar</directory>
                            <targetPath>WEB-INF/lib</targetPath>
                            <includes><include>*.jar</include></includes>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>