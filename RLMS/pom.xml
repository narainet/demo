		<!-- RLMS prom 모듈: 규정 전문 → PDF 내보내기(본문저장/연혁일괄저장).
		     flying-saucer(core-renderer R8) + iText 2.0.8(transitive) 로 XHTML→PDF, malgun.ttf 한글 임베딩.
		     xml-apis(apache-xerces:2.9.1) 는 로컬 저장소에 없고 xercesImpl 이 제공하므로 제외.
		     .docx 내보내기는 POI 미사용 — 순수 ZIP+XML(WordprocessingML) 직접 생성. -->
		<dependency>
			<groupId>org.xhtmlrenderer</groupId>
			<artifactId>core-renderer</artifactId>
			<version>R8</version>
			<exclusions>
				<exclusion>
					<groupId>apache-xerces</groupId>
					<artifactId>xml-apis</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- RLMS prom 모듈: "문서에서 가져오기"(.docx/.hwpx 평문 추출) 는 POI 미사용 — 순수 ZIP+SAX.
		     (xmlbeans 2.6.0 고정 vs poi-ooxml 5.x 충돌 회피. 아래 xmlbeans 의존성 주석 참고.)
		     poi-ooxml 은 fdl.excel 가 transitively 제공(5.2.5)하므로 여기서 명시 선언하지 않음. -->

		<!-- RLMS 통합검색 자료 본문 인덱싱(DocImportServiceImpl.extractRawText): 첨부 PDF/구 Word(.doc) 텍스트 추출.
		     - pdfbox 2.0.x: fontbox + commons-logging 만 의존(xmlbeans 무관, JDK 1.8 호환).
		     - poi-scratchpad(HWPF): 구 Word(.doc) 추출. poi(core) 만 의존하고 xmlbeans 는 쓰지 않으므로
		       xmlbeans 2.6.0 핀과 무관. poi-ooxml(fdl.excel 전이 5.2.5) 과 버전 정합 위해 5.2.5 고정.
		     ★ .docx/.hwpx 는 여전히 POI 미사용 ZIP+SAX 경로 유지 — 이 두 라이브러리는 PDF/.doc 전용. -->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>2.0.22</version>
		</dependency>
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-scratchpad</artifactId>
			<version>5.2.5</version>
		</dependency>
		<!-- ★ log4j-api 버전 고정(2.23.1) — poi-scratchpad 5.2.5 가 전이로 log4j-api 2.21.1 을 끌어와
		     Maven 중재를 흔들면, log4j-core 2.23.1 이 요구하는 org.apache.logging.log4j.util.Lazy(2.22+)
		     가 사라져 기동 시 NoClassDefFoundError 로 컨테이너 전멸한다. 직접 의존성은 전이 중재를 무조건
		     이기므로 core/slf4j-impl(2.23.1) 과 api 를 정렬. (poi 추가 이전엔 표면화 안 됐던 잠재 스큐.) -->
