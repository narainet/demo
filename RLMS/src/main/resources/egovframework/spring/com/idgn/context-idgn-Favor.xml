<?xml version="1.0" encoding="UTF-8"?>
<!--
  물리적 저장 경로: /src/main/resources/egovframework/spring/com/idgn/context-idgn-Favor.xml
  egovFavorIdGnrService : TB_FAVOR.IFAVOR_NO ← COMTECOPSEQ.FAVOR_ID
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans-4.0.xsd">

    <bean name="egovFavorIdGnrService"
          class="org.egovframe.rte.fdl.idgnr.impl.EgovTableIdGnrServiceImpl"
          destroy-method="destroy">
        <property name="dataSource" ref="egov.dataSource"/>
        <property name="strategy"   ref="favorIdStrategy"/>
        <property name="blockSize"  value="10"/>
        <property name="table"      value="COMTECOPSEQ"/>
        <property name="tableName"  value="FAVOR_ID"/>
    </bean>
    <bean name="favorIdStrategy"
          class="org.egovframe.rte.fdl.idgnr.impl.strategy.EgovIdGnrStrategyImpl">
        <property name="cipers" value="20"/>
    </bean>

</beans>
