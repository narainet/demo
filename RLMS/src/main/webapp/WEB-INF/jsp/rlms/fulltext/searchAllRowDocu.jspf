<%-- 통합검색 행: 별표/별지서식 (searchAll.jsp 전용 static include — 변수 row) --%>
<%@ page pageEncoding="UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<div class="us-item">
  <div class="t">
    <a href="<c:url value='/rlms/fulltext/provisionList.do'/>?promNo=${row.promNo}#docu-${row.docuNo}">
      <%-- 공백뿐인 그룹제목([ ]) 방어 --%>
      <c:if test="${not empty row.grpTitle and fn:length(fn:replace(row.grpTitle, ' ', '')) > 0}">[<c:out value="${row.grpTitle}"/>] </c:if><c:out value="${row.title}"/>
    </a>
  </div>
  <div class="meta"><c:out value="${row.promTitle}"/></div>
</div>
