<%-- 통합검색 행: 자료(관련자료 FILE/WORD) (searchAll.jsp 전용 static include — 변수 row) --%>
<%@ page pageEncoding="UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<div class="us-item">
  <div class="t">
    <span class="us-kind"><c:out value="${row.kind eq 'WORD' ? '문서' : '파일'}"/></span>
    <a href="<c:url value='/rlms/fulltext/provisionList.do'/>?promNo=${row.promNo}"><c:out value="${row.title}"/></a>
  </div>
  <c:if test="${not empty row.snippet}">
    <div class="snip"><c:out value="${row.snippet}"/>&#8230;</div>
  </c:if>
  <div class="meta"><c:out value="${row.promTitle}"/> · 관련자료</div>
</div>
