<?xml version="1.0" encoding="UTF-8"?>
<!--
  물리적 저장 경로: /src/main/resources/egovframework/spring/com/idgn/context-idgn-PromMap.xml

  prommap(기능별분류/규정맵) 모듈 PK 채번:
   - egovPromMapIdGnrService : TB_PROM_MAP.IPMAP_NO ← COMTECOPSEQ.TABLE_NAME='PMAP_ID'
  ※ 운영 MAX(IPMAP_NO)=5752 → database/rlms_prommap_idgen_seed.sql 로 NEXT_ID=5753 시드 필요.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans-4.0.xsd">

    <bean name="egovPromMapIdGnrService"
          class="org.egovframe.rte.fdl.idgnr.impl.EgovTableIdGnrServiceImpl"
          destroy-method="destroy">
        <property name="dataSource" ref="egov.dataSource"/>
        <property name="strategy"   ref="pmapIdStrategy"/>
        <property name="blockSize"  value="10"/>
        <property name="table"      value="COMTECOPSEQ"/>
        <property name="tableName"  value="PMAP_ID"/>
    </bean>
    <bean name="pmapIdStrategy"
          class="org.egovframe.rte.fdl.idgnr.impl.strategy.EgovIdGnrStrategyImpl">
        <property name="cipers" value="20"/>
    </bean>

</beans>
