<?xml version="1.0" encoding="UTF-8"?>
<!--
  물리적 저장 경로: /src/main/resources/egovframework/spring/com/idgn/context-idgn-RelExclLnk.xml

  자동링크 제외범위 (TB_REL_EXCL_LNK) PK 채번기.
   - COMTECOPSEQ.TABLE_NAME='REL_EXCL_LNK_ID' 사용.
   - 운영 적용 전 INSERT INTO COMTECOPSEQ VALUES ('REL_EXCL_LNK_ID', 1) 필요.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans-4.0.xsd">

    <bean name="egovRelExclLnkIdGnrService"
          class="org.egovframe.rte.fdl.idgnr.impl.EgovTableIdGnrServiceImpl"
          destroy-method="destroy">
        <property name="dataSource" ref="egov.dataSource"/>
        <property name="strategy"   ref="relExclLnkIdStrategy"/>
        <property name="blockSize"  value="10"/>
        <property name="table"      value="COMTECOPSEQ"/>
        <property name="tableName"  value="REL_EXCL_LNK_ID"/>
    </bean>

    <bean name="relExclLnkIdStrategy"
          class="org.egovframe.rte.fdl.idgnr.impl.strategy.EgovIdGnrStrategyImpl">
        <property name="cipers" value="20"/>
    </bean>

</beans>
